# guichet/.gitignore — v0.1 (public tenant repository of Carlingue)
# Rule of thumb: ignore what is generated, local, large, or secret.
# Deliberately COMMITTED: pnpm-lock.yaml, .sops.yaml and *.enc.yaml, Pulumi.demo.yaml
# (encrypted secrets), renovate.json, .npmrc (token from env), eval/fixtures/ (small subset
# with PDFs and sidecars), CLAUDE.md / AGENTS.md / .claude/settings.json.
# Never commit a link:/file:/workspace: dependency on Carlingue — use `pnpm dev:link` (not in git).

# ---------- Node / pnpm / TypeScript / Turborepo ----------
node_modules/
.pnpm-store/
.turbo/
dist/
build/
*.tsbuildinfo
.eslintcache
coverage/
*.tgz
*.log
npm-debug.log*
pnpm-debug.log*

# ---------- Environment and secrets ----------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
keys.txt            # age identity for SOPS (encrypted *.enc.yaml files ARE committed)
*.age.key
*.credentials.json
.npmrc.local

# ---------- Local runtime data (docker compose volumes, scratch) ----------
.local/
out/
tmp/
docker-volumes/
pgdata/
minio-data/
redpanda-data/
clickhouse-data/
langfuse-data/

# ---------- Synthetic data and eval outputs ----------
# Rendered packets live in object storage; only eval/fixtures/ is committed.
packages/synthetic-lending/out/
packages/synthetic-lending/.cache/
eval/runs/
eval/baselines/*.local.json
**/*.pdf
!eval/fixtures/**/*.pdf
!packages/synthetic-lending/fixtures/**/*.pdf

# ---------- Pulumi (thin per-tenant program only; no Terraform here) ----------
# Pulumi.demo.yaml is committed; ephemeral pr-N configs are generated by the pipeline.
Pulumi.pr-*.yaml
.pulumi/
infra/bin/
infra/.automation/

# ---------- Testing ----------
playwright-report/
test-results/
blob-report/
playwright/.cache/

# ---------- Docker ----------
*.tar
.docker/

# ---------- Editors / OS ----------
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo
*~

# ---------- Local AI coding agents ----------
.claude/settings.local.json
.aider*
*.local.md
.agent-scratch/
